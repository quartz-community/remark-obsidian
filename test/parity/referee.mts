/**
 * Measure this package against a second, independently recorded oracle.
 *
 * The Obsidian Footnotes Shortcuts plugin records Obsidian's own answer for
 * ~6800 notes through `metadataCache.computeMetadataAsync`, storing each as
 * `{ id, text, defs, refs }` where `defs` is `[name, line, col, lastLine]` and
 * `refs` is `[name, line, col]`, both zero-based. Replaying them needs no
 * Obsidian at all, which makes it the cheapest oracle here and a stricter one
 * than our own corpus: it compares exact positions, and it was generated by
 * someone else's fuzzer against someone else's reading of the same parser.
 *
 * This is a **measurement**, not a gate. The corpus is not vendored -- it is a
 * sibling project's test data on its own release cycle -- so this reports and
 * exits rather than failing a build. Point it at a clone:
 *
 *     git clone --depth 1 https://github.com/Comprehensive-Jason/obsidian-footnotes /tmp/of
 *     PARITY_REFEREE_DIR=/tmp/of/test/obsidian-answers \
 *       npx tsx --conditions=development test/parity/referee.mts
 *
 * `--conditions=development` matters for the reason it does everywhere else
 * here: without it micromark's assertions are off and a real invariant violation
 * passes silently.
 */
import fs from "node:fs";
import path from "node:path";
import { parseOurs } from "./chain.js";

interface Point {
  readonly line: number;
  readonly column: number;
  readonly offset?: number;
}

interface Entry {
  readonly id: string;
  readonly text: string;
  readonly defs: ReadonlyArray<readonly [string, number, number, number]>;
  readonly refs: ReadonlyArray<readonly [string, number, number]>;
}

const dir =
  process.env.PARITY_REFEREE_DIR ??
  "/tmp/obsidian-footnotes/test/obsidian-answers";

if (!fs.existsSync(dir)) {
  console.log(`referee: no corpus at ${dir}`);
  console.log(
    "         set PARITY_REFEREE_DIR to a clone's test/obsidian-answers",
  );
  process.exit(0);
}

/**
 * Our answer in the recorded shape: zero-based, and only what Obsidian records.
 *
 * A definition inside a `%%` comment does not define, while a reference inside
 * one is still indexed -- `%%⏎[^1]: buried⏎%%⏎text[^1]` renders `text1`, so the
 * reference resolves against nothing. Both halves are recorded rules, and the
 * asymmetry is why this walks with a flag instead of pruning the subtree.
 *
 * It has to be stated here because `parseComments` puts a comment's body in its
 * `children` as real nodes, so a plain `visit` counts the buried definition and
 * reports every such document as one where we invent a definition Obsidian
 * lacks. That was 247 of this corpus's disagreements and none of them were real.
 */
function ours(text: string) {
  const tree = parseOurs(text, "all-features");
  const defs: [string, number, number, number][] = [];
  const refs: [string, number, number][] = [];
  let unplaced = 0;

  const walk = (node: unknown, inComment: boolean): void => {
    const candidate = node as {
      type?: string;
      identifier?: string;
      position?: { start: Point; end: Point };
      children?: unknown[];
    };
    const at = candidate.position;
    const id = () => String(candidate.identifier);

    if (candidate.type === "footnoteDefinition") {
      if (!inComment) {
        if (!at) unplaced++;
        else
          defs.push([
            id(),
            at.start.line - 1,
            at.start.column - 1,
            at.end.line - 1,
          ]);
      } else if (at) {
        // A definition buried in a comment does not define, and its label is still
        // indexed as a REFERENCE. `> %%` over `[^3]: Text` reports no definition and a
        // reference at 1:0 -- the quoted `%%` runs to the end of the note, the definition
        // fails, and the name is indexed anyway. Measured here at +123 documents against 7,
        // and all 7 are notes where a FENCE sits inside the comment and our comment extent
        // differs from Obsidian's, which is a separate and already-tracked class.
        //
        // This rule was refuted four times before, at 444/329, 578/237 and 540/273, and
        // written up as permanently abandoned. Every one of those measurements classified
        // the premise with a hand-rolled `%%` scan over the note's text, and that scan was
        // the thing being measured. Splitting out the control exposed it: of the label
        // lines it called "inside an open comment" with no definition, 319 were notes where
        // Obsidian DOES define the label, so the premise never applied and they were not
        // counter-examples at all. Removing them took the rule from 57.5% to 81.5%, and
        // teaching the scan about fences took it to 86%.
        //
        // The scan was never needed. Our own parser computes comment extents, so asking the
        // TREE which definitions are buried is both exact and what a consumer sees. That is
        // the measurement that settles it, and it is the one that should have been run first.
        //
        // It belongs in this projection rather than in the tree: a `footnoteDefinition`
        // nested inside a `comment` is more informative than a reference, a formatter needs
        // the definition's own span to rewrite the line, and synthesising a reference node
        // would put a construct in the tree that no source character spells. Where
        // Obsidian's INDEX reinterprets a node, the reinterpretation belongs downstream --
        // the same rule that keeps a dangling reference and a surplus table cell in the tree.
        refs.push([id(), at.start.line - 1, at.start.column - 1]);
      }
    } else if (candidate.type === "footnoteReference") {
      if (!at) unplaced++;
      else refs.push([id(), at.start.line - 1, at.start.column - 1]);
    }

    const buried = inComment || candidate.type === "comment";
    for (const child of candidate.children ?? []) walk(child, buried);
  };

  walk(tree, false);
  return { defs, refs, unplaced };
}

const same = (a: unknown, b: unknown) =>
  JSON.stringify(a) === JSON.stringify(b);
const names = (rows: ReadonlyArray<readonly unknown[]>) =>
  JSON.stringify(rows.map((row) => row[0]).sort());

let total = 0;
let agree = 0;
let unplaced = 0;
const kinds = new Map<string, number>();
const bump = (kind: string) => kinds.set(kind, (kinds.get(kind) ?? 0) + 1);

for (const file of fs.readdirSync(dir).filter((f) => f.endsWith(".json"))) {
  const raw: unknown = JSON.parse(
    fs.readFileSync(path.join(dir, file), "utf8"),
  );
  const entries = (
    Array.isArray(raw) ? raw : Object.values(raw as Record<string, unknown>)
  ) as Entry[];

  for (const entry of entries) {
    total++;
    let got;
    try {
      got = ours(entry.text);
    } catch {
      bump("our parse threw");
      continue;
    }
    unplaced += got.unplaced;

    const defsMatch = same(got.defs, entry.defs);
    const refsMatch = same(got.refs, entry.refs);
    if (defsMatch && refsMatch) {
      agree++;
      continue;
    }
    // Names first: finding a different *set* is a parse disagreement, while the
    // same set in a different place is a position one, and the two want
    // completely different work.
    const sameNames =
      names(got.defs) === names(entry.defs) &&
      names(got.refs) === names(entry.refs);
    if (sameNames) bump("same names, different spans");
    else if (!defsMatch && !refsMatch) bump("both sets differ");
    else if (!defsMatch) bump("definition set differs");
    else bump("reference set differs");
  }
}

console.log(
  `referee: ${agree}/${total} agree (${((100 * agree) / total).toFixed(1)}%)`,
);
console.log(`  nodes spliced without a position: ${unplaced}`);
console.log("\ndisagreement kinds:");
for (const [kind, count] of [...kinds].sort((a, b) => b[1] - a[1])) {
  console.log(`  ${String(count).padStart(5)}  ${kind}`);
}
