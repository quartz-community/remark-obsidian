/**
 * Measure this package against a second, independently recorded oracle.
 *
 * The Obsidian Footnotes Shortcuts plugin records Obsidian's own answer for
 * ~6800 notes through `metadataCache.computeMetadataAsync`, storing each as
 * `{ id, text, defs, refs }` where `defs` is `[name, line, col, lastLine]` and
 * `refs` is `[name, line, col]`, both zero-based. Replaying them needs no
 * Obsidian at all, which makes it the cheapest oracle here and a stricter one
 * than our own corpus: it compares exact positions, and it was generated by
 * someone else's fuzzer against someone else's reading of the same parser.
 *
 * This is a **measurement**, not a gate. The corpus is not vendored -- it is a
 * sibling project's test data on its own release cycle -- so this reports and
 * exits rather than failing a build. Point it at a clone:
 *
 *     git clone --depth 1 https://github.com/Comprehensive-Jason/obsidian-footnotes /tmp/of
 *     PARITY_REFEREE_DIR=/tmp/of/test/obsidian-answers \
 *       npx tsx --conditions=development test/parity/referee.mts
 *
 * `--conditions=development` matters for the reason it does everywhere else
 * here: without it micromark's assertions are off and a real invariant violation
 * passes silently.
 */
import fs from "node:fs";
import path from "node:path";
import { refereeFactsWithTree } from "./referee-facts.js";

interface Point {
  readonly line: number;
  readonly column: number;
  readonly offset?: number;
}

interface Entry {
  readonly id: string;
  readonly text: string;
  readonly defs: ReadonlyArray<readonly [string, number, number, number]>;
  readonly refs: ReadonlyArray<readonly [string, number, number]>;
  /**
   * Obsidian's own ROOT-LEVEL code-block line ranges, `[[start, end], ...]`, zero-based and
   * inclusive.
   *
   * Recorded on every one of these documents since the corpus was made and read by NOTHING
   * until now -- 883 of 6,818 hold a non-empty one. That is the third dormant field this
   * harness has found (`referenceLinks` was the first, at 111 answers) and by far the largest,
   * and it is an oracle for exactly the construct family the definition and reference work
   * keeps running into: where a fence or an indented block begins and ends.
   *
   * ROOT LEVEL ONLY, measured rather than assumed. Comparing every `code` node in the tree
   * agrees on 52.4%; comparing only the tree's own children agrees on 82.9%, and every extra
   * block in the first reading was one inside a container -- `> [^a]: d` / `>` / `⇥continued` /
   * blank / `>⟨5sp⟩``` ` records `[[2,2]]`, the root indented code, and not the quoted fence.
   */
  readonly code?: ReadonlyArray<readonly [number, number]>;
}

const dir =
  process.env.PARITY_REFEREE_DIR ??
  "/tmp/obsidian-footnotes/test/obsidian-answers";

if (!fs.existsSync(dir)) {
  console.log(`referee: no corpus at ${dir}`);
  console.log(
    "         set PARITY_REFEREE_DIR to a clone's test/obsidian-answers",
  );
  process.exit(0);
}

/**
 * Our answer in the recorded shape: zero-based, and only what Obsidian records.
 *
 * A definition inside a `%%` comment does not define, while a reference inside
 * one is still indexed -- `%%⏎[^1]: buried⏎%%⏎text[^1]` renders `text1`, so the
 * reference resolves against nothing. Both halves are recorded rules, and the
 * asymmetry is why this walks with a flag instead of pruning the subtree.
 *
 * It has to be stated here because `parseComments` puts a comment's body in its
 * `children` as real nodes, so a plain `visit` counts the buried definition and
 * reports every such document as one where we invent a definition Obsidian
 * lacks. That was 247 of this corpus's disagreements and none of them were real.
 */
/**
 * An EMPTY-named reference is excluded from BOTH sides, which is the corpus's own convention.
 *
 * `^[]` is in Obsidian's cache as a reference with an empty name, and their rules document
 * says so under E3 -- and then says Reading View renders nothing there, "so it is no
 * reference; the oracle's comparison leaves it out". The producer of this corpus therefore
 * does not compare the field, while we were comparing it, which made our figure stricter than
 * the data was recorded for rather than more accurate.
 *
 * It is 20 answers here, 16 of which disagree ONLY by this, and we emit ZERO of them. Their
 * own notes put it at ~1,300 notes, which is their 20,000-note run and not this corpus.
 *
 * Not a parse gap, and the app itself is undecided: E3 says Reading View renders nothing,
 * while D7 records a day when it drew a marker `[1]` with an empty footnote. Synthesising a
 * node for something that renders nothing is what this package refuses elsewhere, so the
 * exclusion belongs in the comparison and is labelled in the output rather than folded in
 * silently.
 */
const named = (rows: ReadonlyArray<readonly unknown[]>) =>
  rows.filter((row) => row[0] !== "");

const same = (
  a: ReadonlyArray<readonly unknown[]>,
  b: ReadonlyArray<readonly unknown[]>,
) => JSON.stringify(named(a)) === JSON.stringify(named(b));
const names = (rows: ReadonlyArray<readonly unknown[]>) =>
  JSON.stringify(rows.map((row) => row[0]).sort());

let total = 0;
let agree = 0;
let unplaced = 0;
let withCode = 0;
let codeAgree = 0;
/**
 * ASSERTIONS, beside the all-or-nothing document figure.
 *
 * A document agrees only when EVERY definition and reference in it matches, so a rule that is
 * the SECOND error in three hundred documents yields nothing here and is invisible to a
 * selector that counts documents. That is measured, not supposed: of 789 failing documents 306
 * are ONE assertion away and 349 are two, so five correct rules landed in one session moved
 * 1479 wrong assertions and only 16 documents.
 *
 * Reporting both is what lets work be chosen by yield instead of by population. The document
 * figure stays the headline because it is the contract; this is the gradient.
 */
let defsWanted = 0;
let defsMatched = 0;
let refsWanted = 0;
let refsMatched = 0;
const codeKinds = new Map<string, number>();
const kinds = new Map<string, number>();
const bump = (kind: string) => kinds.set(kind, (kinds.get(kind) ?? 0) + 1);

/**
 * `--ids` prints the KEY of every agreeing document and nothing else.
 *
 * A net figure cannot say which documents moved, and a section-geometry fix is expected to
 * move this oracle by at most a document or two -- so "78.9% became 78.9%" and "one document
 * traded for another" are indistinguishable from the summary. Diffing two id dumps names the
 * document, which is the only way to tell a predicted wobble from a real regression.
 *
 * It belongs here rather than in a scratch script because the comparison must be the SAME
 * one: a reimplemented agreement test reads as independent confirmation while actually
 * measuring something slightly different.
 */
const wantIds = process.argv.includes("--ids");
const agreed: string[] = [];

/**
 * `--dump <file>` records every answer; `--blast <file>` diffs against one.
 *
 * THE BUCKET BOTH OTHER VIEWS ARE BLIND TO. The summary says whether the total moved and
 * `--ids` says which documents changed side, and a document that was wrong before and is wrong
 * in a DIFFERENT WAY afterwards appears in neither -- it never changed side, so the identity
 * diff is empty, and the total is unmoved.
 *
 * That is not a hypothetical. B3's content-column fix altered the answer for exactly four of
 * these 6,818 documents, every one of them a designed B3 probe carrying Obsidian's recorded
 * answer, and all four say the definition should not exist at all. The fix was correct and
 * HALF THE RULE, and both of the cheap checks this harness reaches for first reported nothing:
 * 0 corpus regressions and an identity-diff of `lost=0 gained=0`.
 *
 * So the question a change has to be asked is not "did agreement move" but "which answers did
 * it ALTER, and does the oracle endorse each new one". `--blast` asks that:
 *
 *     git stash && npx tsx ... referee.mts --dump /tmp/before.json && git stash pop
 *     npx tsx ... referee.mts --blast /tmp/before.json
 *
 * `still wrong` is the bucket to read. Every row in it is a document whose answer this change
 * rewrote while the oracle disagrees with both spellings -- which is either a rule that is
 * incomplete, or one firing where it should not, and the oracle's own column is printed beside
 * it so the difference is readable without a second tool.
 */
const valueOf = (flag: string): string | undefined => {
  const at = process.argv.indexOf(flag);
  return at === -1 ? undefined : process.argv[at + 1];
};
const dumpTo = valueOf("--dump");
const blastFrom = valueOf("--blast");
const snapshot: Record<string, { answer: string; agreed: boolean }> = {};
const baseline: Record<string, { answer: string; agreed: boolean }> =
  blastFrom === undefined
    ? {}
    : (JSON.parse(fs.readFileSync(blastFrom, "utf8")) as typeof baseline);
const blast: Array<{
  key: string;
  bucket: "gained" | "lost" | "still wrong" | "equivalent";
  before: string;
  after: string;
  oracle: string;
}> = [];

for (const file of fs.readdirSync(dir).filter((f) => f.endsWith(".json"))) {
  const raw: unknown = JSON.parse(
    fs.readFileSync(path.join(dir, file), "utf8"),
  );
  const entries = (
    Array.isArray(raw) ? raw : Object.values(raw as Record<string, unknown>)
  ) as Entry[];

  for (const [at, entry] of entries.entries()) {
    total++;
    const key = `${file}#${at}`;
    let got;
    try {
      got = refereeFactsWithTree(entry.text);
    } catch {
      bump("our parse threw");
      continue;
    }
    unplaced += got.unplaced;

    // The `code` dimension, reported beside the footnote one rather than folded into it: it is
    // a different question, it has its own population, and mixing them would make neither
    // figure readable.
    const wantCode = entry.code ?? [];
    if (wantCode.length > 0) {
      withCode++;
      const ourCode: Array<[number, number]> = [];
      for (const child of got.tree.children) {
        if (child.type === "code" && child.position) {
          ourCode.push([
            child.position.start.line - 1,
            child.position.end.line - 1,
          ]);
        }
      }
      const a = JSON.stringify([...wantCode].sort());
      const b = JSON.stringify(ourCode.sort());
      if (a === b) codeAgree++;
      else {
        const kind =
          ourCode.length === 0
            ? "we report NO root code block"
            : wantCode.length !== ourCode.length
              ? `block count differs (${wantCode.length} vs ${ourCode.length})`
              : JSON.stringify(wantCode.map((x) => x[0]).sort()) !==
                  JSON.stringify(ourCode.map((x) => x[0]).sort())
                ? "a block STARTS elsewhere"
                : "a block ENDS elsewhere";
        codeKinds.set(kind, (codeKinds.get(kind) ?? 0) + 1);
      }
    }

    const defsMatch = same(got.defs, entry.defs);
    const refsMatch = same(got.refs, entry.refs);
    if (dumpTo !== undefined || blastFrom !== undefined) {
      const agreeNow = defsMatch && refsMatch;
      const answer = JSON.stringify([got.defs, got.refs]);
      snapshot[key] = { answer, agreed: agreeNow };
      const was = baseline[key];
      if (was !== undefined && was.answer !== answer) {
        blast.push({
          key,
          // `equivalent` is a real outcome rather than a tidy-up: `same()` normalises both
          // ends and drops empty-named references, so two different spellings can both agree
          // and that is slack in the COMPARISON, not a change in correctness.
          bucket:
            agreeNow && was.agreed
              ? "equivalent"
              : agreeNow
                ? "gained"
                : was.agreed
                  ? "lost"
                  : "still wrong",
          before: was.answer,
          after: answer,
          oracle: JSON.stringify([entry.defs, entry.refs]),
        });
      }
    }
    // Counted for every document, agreeing or not, and MULTISET-wise: a name repeated at two
    // places is two assertions, which a set would collapse -- the same trap that made the
    // shrinker's name-keyed signature wrongly skip 46 documents.
    const overlap = (
      want: ReadonlyArray<readonly unknown[]>,
      mine: ReadonlyArray<readonly unknown[]>,
    ): number => {
      const pool = mine.map((row) => JSON.stringify(row));
      let hit = 0;
      for (const row of want) {
        const at = pool.indexOf(JSON.stringify(row));
        if (at >= 0) {
          pool.splice(at, 1);
          hit += 1;
        }
      }
      return hit;
    };
    defsWanted += entry.defs.length;
    defsMatched += overlap(entry.defs, got.defs);
    refsWanted += entry.refs.length;
    refsMatched += overlap(entry.refs, got.refs);

    if (defsMatch && refsMatch) {
      agree++;
      if (wantIds) agreed.push(key);
      continue;
    }
    // Names first: finding a different *set* is a parse disagreement, while the
    // same set in a different place is a position one, and the two want
    // completely different work.
    const sameNames =
      names(got.defs) === names(entry.defs) &&
      names(got.refs) === names(entry.refs);
    if (sameNames) bump("same names, different spans");
    else if (!defsMatch && !refsMatch) bump("both sets differ");
    else if (!defsMatch) bump("definition set differs");
    else bump("reference set differs");
  }
}

if (dumpTo !== undefined) {
  fs.writeFileSync(dumpTo, JSON.stringify(snapshot));
  console.log(`dumped ${Object.keys(snapshot).length} answers to ${dumpTo}`);
  process.exit(0);
}

if (blastFrom !== undefined) {
  const buckets = new Map<string, number>();
  for (const row of blast) {
    buckets.set(row.bucket, (buckets.get(row.bucket) ?? 0) + 1);
  }
  console.log(`blast radius against ${blastFrom}`);
  console.log(`  answers ALTERED : ${blast.length} of ${total}`);
  for (const bucket of ["gained", "lost", "still wrong", "equivalent"]) {
    console.log(`    ${bucket.padEnd(12)} ${buckets.get(bucket) ?? 0}`);
  }
  if (blast.length === 0) {
    console.log(
      "\n  NO EVIDENCE. This oracle's answers are UNCHANGED by the edit, so it cannot\n" +
        "  adjudicate it -- a clean result here is not a passing one. This harness's most\n" +
        "  expensive mistake was a zero-regression reading from a corpus holding no case for\n" +
        "  the rule, which read exactly like evidence and shipped a regression. Reach for a\n" +
        "  probe wave (test/parity/ask.mts) instead of trusting this.",
    );
  }
  // LOST FIRST, because it is the bucket that decides whether a rule ships. Only `still
  // wrong` was printed here, so a change with `lost 7` gave no way to see WHICH seven or HOW
  // they moved -- and the obvious workaround, re-running a scored candidate, measures the
  // candidate rather than the implementation. The two disagreed by 7 documents on the change
  // that exposed this.
  const regressed = blast.filter((row) => row.bucket === "lost");
  if (regressed.length > 0) {
    console.log(
      `\n  LOST -- the oracle endorsed the old answer and does not endorse the new one.`,
    );
    for (const row of regressed.slice(0, 40)) {
      console.log(`\n  ${row.key}`);
      console.log(`    before = ${row.before}`);
      console.log(`    after  = ${row.after}`);
      console.log(`    oracle = ${row.oracle}`);
    }
    if (regressed.length > 40) {
      console.log(`\n  ...and ${regressed.length - 40} more`);
    }
  }
  const silent = blast.filter((row) => row.bucket === "still wrong");
  if (silent.length > 0) {
    console.log(
      `\n  STILL WRONG -- rewritten where the oracle disagrees with both spellings.`,
    );
    console.log(
      `  Neither the agreement total nor --ids can see these, which is why they are listed.`,
    );
    for (const row of silent.slice(0, 40)) {
      console.log(`\n  ${row.key}`);
      console.log(`    before = ${row.before}`);
      console.log(`    after  = ${row.after}`);
      console.log(`    oracle = ${row.oracle}`);
    }
    if (silent.length > 40) {
      console.log(`\n  ...and ${silent.length - 40} more`);
    }
  }
  process.exit(0);
}

if (wantIds) {
  for (const key of agreed) console.log(key);
  process.exit(0);
}

console.log(
  `referee: ${agree}/${total} agree (${((100 * agree) / total).toFixed(1)}%)`,
);
console.log(
  "  empty-named references excluded from both sides, as the corpus's own comparator does",
);
{
  const assertions = defsMatched + refsMatched;
  const wanted = defsWanted + refsWanted;
  const pc = (a: number, b: number) =>
    `${a}/${b} (${((100 * a) / b).toFixed(2)}%)`;
  console.log(`  ASSERTIONS matched: ${pc(assertions, wanted)}`);
  console.log(`    definitions      ${pc(defsMatched, defsWanted)}`);
  console.log(`    references       ${pc(refsMatched, refsWanted)}`);
}
console.log(`  nodes spliced without a position: ${unplaced}`);
console.log(
  `\ncode blocks (root level), a dimension nothing read until now:` +
    `\n  ${codeAgree}/${withCode} agree (${((100 * codeAgree) / withCode).toFixed(1)}%)`,
);
for (const [kind, count] of [...codeKinds].sort((a, b) => b[1] - a[1])) {
  console.log(`  ${String(count).padStart(5)}  ${kind}`);
}
console.log("\ndisagreement kinds:");
for (const [kind, count] of [...kinds].sort((a, b) => b[1] - a[1])) {
  console.log(`  ${String(count).padStart(5)}  ${kind}`);
}
