{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": ["src/**/*.ts", "!src/index.ts"],
  "coverageAnalysis": "perTest",
  "concurrency": 12,
  "timeoutMS": 30000,
  "reporters": ["progress", "clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "clearTextReporter": {
    "maxTestsToLog": 0
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "disableTypeChecks": "src/**/*.ts",
  "ignorePatterns": [
    ".codegraph",
    ".git",
    "node_modules",
    "dist",
    "coverage",
    ".stryker-tmp",
    "reports",
    "test/parity/fixtures",
    ".direnv",
    "result"
  ]
}
