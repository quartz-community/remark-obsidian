{
  "name": "@quartz-community/remark-obsidian",
  "version": "2.0.0",
  "description": "Remark plugin that parses Markdown the way Obsidian does: wikilinks and embeds, callouts, highlights, tags, %% comments, math, footnotes and inline footnotes, frontmatter and custom task boxes. A legacy preset reproduces Obsidian's own parser and positions; a strict preset follows CommonMark and GFM.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-THIRD-PARTY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:parity": "vitest run test/parity",
    "parity:record": "NODE_OPTIONS=--conditions=development wdio run ./wdio.conf.mts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.parity.json --noEmit",
    "prepublishOnly": "npm run build",
    "release": "npm run build && changeset publish",
    "lint": "eslint 'src/**/*.ts'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@obsidian-typings/obsidian-public-latest": "^6.38.0",
    "@quartz-community/rehype-obsidian": "^1.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "character-entities-legacy": "^3.0.0",
    "decode-named-character-reference": "^1.3.0",
    "devlop": "^1.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-redos": "^4.5.0",
    "js-yaml": "^4.3.2",
    "mdast-util-assert": "^5.0.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-math": "^3.0.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-symbol": "^2.0.0",
    "micromark-util-types": "^2.0.0",
    "mocha": "^11.8.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "remarkFootnotes2": "npm:remark-footnotes@^2.0.0",
    "remarkMath3": "npm:remark-math@^3.0.1",
    "remarkParse8": "npm:remark-parse@^8.0.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "unified9": "npm:unified@^9.2.2",
    "unist-util-visit": "^5.0.0",
    "vitest": "^2.1.9",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1",
    "webdriverio": "^9.32.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/remark-obsidian"
  }
}
